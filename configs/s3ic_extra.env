# s3ic per-segment options as of segment 29 (2026-11-20).
# Copy to src/s3/runs/s3ic/extra.env (doc/training.md section 8). Read by src/s3/run_s3.sh at every segment start,
# so a change applies at the next segment without restarting the supervisor.
# Do NOT put potion_mix=, asc_weights or ASC_MIX here: the chain hook sets them per segment (segment.env), and an
# actor refuses a key given twice.
# The --bc file is the macro trainer's reference policy; its KL weight is 0 here (KL_RUNS=1 in config.env).
# Paths are relative to the repository root.

# actors (meanings: doc/architecture.md section 8)
EXTRA_ACTOR_ARGS="character=ironclad era=6 tf_heal=1 hall_sims=0.5 boss_pfull=1 practice_boss=3 practice_min_act=3 practice_pfull=0.5 candidates=4 look_beta=20 potion_mix_shrink=0.2 potion_mix_extra=1 fake_merchant=1 win_bound=0.001 deck_route=1 lethal_backstop=1"
COMBAT_WINDOW=6000000

# combat trainer: weight decay on weight matrices only; 1M replay entries carried to the next segment
EXTRA_CTRAIN_ARGS="--surprise 0.5 --ema 0.999 --carry-keep 1000000 --lr 5e-5 --wd 0.05 --wd-groups matrices --config vdrop=0.3"

# macro trainer: value window 50k runs; milestone heads; outcome = 0.85 won + 0.15 acts cleared / 3
EXTRA_MTRAIN_ARGS="--window-runs 50000 --value-row-share 0.16 --value-steps 150 --value-dropout --value-wd 0.1 --prob-avg --policy-warmup-s 600 --alpha 0.85 --milestones --bc src/s3/runs/s3ic_init/macro_s1_v113.pt --eval-batch 1024"

# replay windows and optimizer states kept across segments; GPU shared through CUDA MPS
CARRY=1
MPS=1

# inference servers: CUDA graphs, two combat batches in flight
EXTRA_SERVER_ARGS="--graphs 1 --overlap 1 --overlap-min 48"
CSERVERS=2
OBS=5
EXTRA_MSERVER_ARGS="--mgraphs 1"

# shadow combat trainer (since segment 29): d=256, 3 layers, 8 heads, ext=1, 3.26M parameters, from random weights.
# It writes shadow.pt, which actors do not use; see doc/architecture.md section 9.
SHADOW_ARGS="--d 256 --layers 3 --config heads=8 --config ext=1 --config vdrop=0.3 --config dropout=0.1 --wd-groups matrices --wd 0.01 --lr 3e-4 --lr-schedule cosine --lr-min 5e-5 --total-steps 340000 --lr-continue --surprise 0.5 --ema 0.999 --window 4000000"
SHADOW_CARRY_KEEP=1000000
SHADOW_PRELOAD_CARRY=1
