# s3ic chain settings as of segment 29 (2026-11-20): Ironclad A10 self-play on game v0.113.1.
# Copy to src/s3/runs/s3ic/config.env before src/ic113/s3ic_launch.sh (doc/training.md section 8).
# Read by src/s3/s3_supervise.sh at every (re)start; SEG is re-read every segment. ASC_MIX is overridden every
# segment by the curriculum (the hook's segment.env). Server-specific values were removed or replaced:
#   NC_ROOT  - rclone remote and folder for backups; replace "myremote" with your own remote.
#   N, EVAL_N, CSERVERS - sized for a 64-thread CPU with one 32 GB GPU; scale to your machine.
# Paths are relative to the repository root.
export N='60'                 # self-play actors
export SEG='10800'            # segment length in seconds (7200 up to segment 27)
export ASC='10'               # target ascension
export ASC_MIX='0.20'         # share of runs at ASC; replaced by the curriculum stage
export CONC='32'              # runs in flight per actor
export CSERVERS='2'           # combat inference processes
export RUNS_PER_ITER='2560'   # macro trainer update interval (runs)
export KL_RUNS='1'            # KL weight toward the human-data policy is zero after 1 run
export PPO_TARGET_KL='0.03'
export COMBAT_WINDOW='6000000'
export EVAL_COUNT='300'       # evaluation panel: 300 seeds Y100000-Y100299 at A10
export EVAL_N='20'
export EVAL_SEEDS='Y'
export EVAL_FIRST='100000'
export STOP_INSTANCE='0'
export COMBAT0='src/s3/runs/s3ic_init/weights.pt'
export MACRO0='src/s3/runs/s3ic_init/macro.pt'
export NC_ROOT='myremote:sts2_backup/s3ic'
export CHAIN_HOOK='src/ic113/s3ic_hook.sh'
export KEEP_EVERY='4'         # upload 1 in 4 training chunks
export FIGHT_KEEP_EVERY='1'   # upload all fight logs
export PRUNE_KEEP='0'         # prune bulk data of uploaded segments
export ACTOR_MEM_GB='8'       # kill an actor above 8 GB resident memory
export EVAL_BASE_ARGS='character=ironclad era=6 tf_heal=1 greedy_map=1 look_beta=20 look_smith=20 look_shop=20 potion_mix_shrink=0.2 potion_mix_extra=1 fake_merchant=1 win_bound=0.001 deck_route=1 lethal_backstop=1'
# ascension curriculum thresholds (src/ic113/chain_stats.py): stage 2 at A10 >= 5% or A0-A4 >= 50%,
# stage 3 at A10 >= 12%, stage 4 at A10 >= 20%; rates over >= 300 self-play runs
export CURRIC_T1_A10='0.05'
export CURRIC_T1_LOW='0.50'
export CURRIC_T2_A10='0.12'
export CURRIC_T3_A10='0.20'
export CURRIC_MIN_RUNS='300'
# potion_mix price table per segment (src/ic113/potion_mix.py vbar)
export VMIX_ROWS='500'
export VMIX_RECENT='20000'
export VMIX_ASC='all'
export VMIX_DEVICE='cuda'
export VMIX_THREADS='16'
# interruptible machines: carries every 10 min, carry backup after every good segment
export CARRY_EVERY='600'
export CARRY_BACKUP_EVERY='1'
