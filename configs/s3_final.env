# Final S3 design (copied into runs/<chain>/extra.env; read at every segment start by src/s3/run_s3.sh).
# Checkpoints and data are not included: pass COMBAT_INIT and MACRO_INIT in the environment.

# Search allocation: hallway cheap, every boss move at full budget, 4 root candidates.
EXTRA_ACTOR_ARGS="hall_sims=0.5 boss_pfull=1 practice_boss=1 practice_min_act=2 practice_pfull=0.25 asc_weights=0,0,0,0,0,0,0,2.762,3.181,4.057 candidates=4"

# Combat trainer: larger replay, lower lr, surprise weighting, EMA, carry the optimizer state.
COMBAT_WINDOW=6000000
EXTRA_CTRAIN_ARGS="--surprise 0.5 --ema 0.999 --carry-keep 3000000 --lr 5e-5"

# Macro trainer: 50k-run value window, 16% of each run's rows, 150 steps, dropout + weight decay, probability
# averaging, and a 10-minute policy warm-up at the start of a segment.
EXTRA_MTRAIN_ARGS="--window-runs 50000 --value-row-share 0.16 --value-steps 150 --value-dropout --value-wd 0.1 --prob-avg --policy-warmup-s 600"

# Keep replay windows and optimizer state across segments.
CARRY=1
EXTRA_N=85
ASC_MIX=0.2125

# GPU sharing: MPS + CUDA graphs + two combat batches in flight.
MPS=1
EXTRA_SERVER_ARGS="--graphs 1 --overlap 1 --overlap-min 48"
CSERVERS=4

# Observation layout v5 (relic counters in the masked Relic slots). The playing network remains a masked v3
# network; only an ext shadow reads the new columns.
OBS=5

# A larger shadow network can be trained on the same chunks; it is compared before it replaces the playing network:
# SHADOW_ARGS="--d 256 --layers 4 --lr 1e-4 --surprise 0.5 --ema 0.999 --window 4000000"
# SHADOW_FROM_PLAYING=1
